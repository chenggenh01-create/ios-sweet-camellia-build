diff --git a/bsd/dev/sweet_touch_mtk.c b/bsd/dev/sweet_touch_mtk.c
--- a/bsd/dev/sweet_touch_mtk.c
+++ b/bsd/dev/sweet_touch_mtk.c
@@ -1199,14 +1199,14 @@
 	(void)bit;
 
 	mali_pwr(mali_p_spm, con, mali_prd(mali_p_spm, con) & ~(1u << 8));   /* SRAM_PDN=0 */
-	if (!mali_wait(mali_p_spm, con, 1u << 12, 0, 1000)) {
