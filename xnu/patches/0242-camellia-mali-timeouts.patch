 		return false;
@@ -1245,9 +1245,14 @@
 	printf("SWEET MALI: MFG0 ok, MFG1 bus release\n");
 	/* MFG1 bus protection release: SRAM first, then way_en and steps. */
 	mali_pwr(mali_p_spm, 0x30C, mali_prd(mali_p_spm, 0x30C) & ~(1u << 8));
