+	    (stride & 3) != 0 || rows < MALI_DIRECT_ROWS ||
+	    available < (size_t)stride * MALI_DIRECT_ROWS ||
+	    !__atomic_compare_exchange_n(&mali_direct_state, &armed,
+	    MALI_LAYER_CAPTURING, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		return;
+	}
+	sweet_mali_layer_retain(surface);
+	mali_direct_layer = (struct mali_direct_layer){
+		.surface = surface, .address = address,
+		.bytes = (size_t)stride * MALI_DIRECT_ROWS, .id = id,
+	};
+	__atomic_store_n(&mali_direct_state, MALI_LAYER_READY, __ATOMIC_RELEASE);
+}
