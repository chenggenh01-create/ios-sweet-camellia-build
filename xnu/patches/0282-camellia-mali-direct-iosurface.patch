+static bool
+mali_map_range(uint64_t gpu, vm_offset_t address, size_t bytes, bool read_only)
+{
+	vm_offset_t offset = address & (MALI_GPU_PAGE - 1);
+	vm_offset_t base = address - offset;
+	for (size_t i = 0; i < bytes + offset; i += MALI_GPU_PAGE) {
+		uint64_t phys = kvtophys(base + i);
