+	/* 1) pre-clk: the BG3D gate lives in the MFG0 domain (mfgcfg), so it is
+	 *    opened only once MFG0 is up.  A write into a domain that is still
+	 *    unpowered is dropped at best, and then MFG1 would fail for a reason
+	 *    the log cannot tell apart from a wrong gate offset. */
+	printf("SWEET MALI: MFG0 ok, bg3d gate on\n");
+	(void)mali_bg3d_gate("pre");
+	printf("SWEET MALI: MFG1 try A (vendor: sram, bus, pwr)\n");
+	if (!mali_mfg1_try("A", true)) {
+		printf("SWEET MALI: MFG1 A failed, bg3d again then try B (redwood: bus, pwr, sram)\n");
+		(void)mali_bg3d_gate("retry");
+		if (!mali_mfg1_try("B", false)) {
+			printf("SWEET MALI: MFG1 both orders failed con=%08x 16C=%08x\n",
+			    mali_prd(mali_p_spm, MALI_MFG1_CON),
+			    mali_prd(mali_p_spm, MALI_SPM_PWR_STATUS));
+			goto fail;
+		}
