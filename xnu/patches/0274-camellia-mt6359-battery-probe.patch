+bool
+SweetBattery::camelliaWait(unsigned state)
+{
+	volatile uint32_t *status = (volatile uint32_t *)(fCamelliaPwrap + kCamelliaPwrapStatus);
+	for (unsigned attempt = 0; attempt < 200; ++attempt) {
+		const uint32_t value = *status;
+		if (!(value & kCamelliaPwrapInitialized)) {
+			return false;
+		}
+		if (((value >> 1) & 7u) == state) {
+			return true;
+		}
+		IODelay(2);
+	}
+	return false;
+}
+
+bool
+SweetBattery::camelliaRead(unsigned address, uint16_t &value)
+{
+	if (!camelliaWait(kCamelliaPwrapIdle)) {
+		return false;
+	}
+
+	/* A read command and its completion handshake never write the PMIC itself. */
+	volatile uint32_t *pwrap = (volatile uint32_t *)fCamelliaPwrap;
+	pwrap[kCamelliaPwrapAccess / 4] = address;
+	if (!camelliaWait(kCamelliaPwrapReadValid)) {
+		return false;
+	}
+	value = (uint16_t)pwrap[kCamelliaPwrapReadData / 4];
+	pwrap[kCamelliaPwrapClearValid / 4] = 1;
+	return true;
+}
+
+void
+SweetBattery::pollCamellia(void)
+{
+	uint16_t id = 0, rtc = 0, chrdet = 0, current = 0, adc = 0;
+	if (!camelliaRead(kMt6359HardwareId, id) || (id & 0xff00u) != 0x5900u ||
+	    !camelliaRead(kMt6359RtcAlarmHour, rtc) ||
+	    !camelliaRead(kMt6359ChargerDetect, chrdet) ||
+	    !camelliaRead(kMt6359GaugeCurrent, current) ||
+	    !camelliaRead(kMt6359AuxadcBattery, adc)) {
+		if (fCamelliaFailures++ == 0) {
+			IOLog("SWEET BATTERY: MT6359 probe failed (id=%#x)\n", id);
+		}
+		return;
+	}
+	fCamelliaFailures = 0;
+	const unsigned saved = (rtc >> 8) & 0x7fu;
+	const bool savedValid = (rtc & 0x8000u) && saved <= 100u;
+	/* RTC stores the last saved Android UI SOC. FG and ADC need fresh
+	 * conversions before these data can be published as live telemetry. */
+	IOLog("SWEET BATTERY: MT6359 id=%#x rtc_soc=%u rtc_valid=%d usb=%u fg_raw=%#x vbat_raw=%#x\n",
+	    id, saved, savedValid, chrdet & 1u, current, adc);
+}
