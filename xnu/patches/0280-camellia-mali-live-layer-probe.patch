+void
+sweet_mali_capture_layer(const void *source, size_t row_bytes, uint32_t id)
+{
+	unsigned armed = MALI_LAYER_ARMED;
+	if (row_bytes < sizeof(mali_layer_pixels) ||
+	    __atomic_load_n(&mali_layer_state, __ATOMIC_RELAXED) != MALI_LAYER_ARMED ||
+	    !__atomic_compare_exchange_n(&mali_layer_state, &armed, MALI_LAYER_CAPTURING,
+	    false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		return;
+	}
+	uint64_t start = mach_absolute_time();
+	memcpy(mali_layer_pixels, source, sizeof(mali_layer_pixels));
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &mali_layer_cpu_ns);
+	mali_layer_id = id;
+	__atomic_store_n(&mali_layer_state, MALI_LAYER_READY, __ATOMIC_RELEASE);
+}
