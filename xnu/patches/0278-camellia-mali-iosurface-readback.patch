+/*
+ * The test buffer has the same backing type and cache attributes as a
+ * surface created by IOSurface.framework. It has no public registry ID.
+ */
+extern "C" void *
+sweet_mali_surface_create(vm_offset_t *address, uint64_t *phys)
+{
+	SweetSurface *surface = sweet_surface_alloc();
+	if (surface == NULL) {
+		IOLog("SWEET MALI: IOSurface allocation failed\n");
+		return NULL;
+	}
+
+	surface->width = surface->height = kSweetMaliTestWidth;
+	surface->bytesPerRow = kSweetMaliTestWidth * sizeof(uint32_t);
+	surface->bytesPerElement = sizeof(uint32_t);
+	surface->elementWidth = surface->elementHeight = 1;
+	surface->pixelFormat = 0x42475241; /* BGRA */
+	surface->allocSize = page_size;
+	surface->mapCache = kIOMapDefaultCache;
+
+	IOByteCount length = 0;
+	uint64_t previous_wired = (uint64_t)OSAddAtomic64(surface->allocSize,
+	    (volatile SInt64 *)&sweet_surface_wired);
+	if (previous_wired + surface->allocSize <= SWEET_SURFACE_WIRED_MAX) {
+		surface->memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, surface->allocSize, page_size);
+	}
+	if (surface->memory == NULL) {
+		OSAddAtomic64(-(SInt64)surface->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+	} else {
+		*address = surface->kernelAddress();
+		*phys = surface->memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+		if (*address != 0 && *phys != 0 && length >= surface->allocSize &&
+		    (*phys & (page_size - 1)) == 0) {
+			return surface;
+		}
+	}
+	IOLog("SWEET MALI: IOSurface backing unavailable or fragmented\n");
+	surface->release();
+	return NULL;
+}
+
+extern "C" void
+sweet_mali_surface_finish(void *opaque, bool passed, uint32_t color)
+{
+	SweetSurface *surface = static_cast<SweetSurface *>(opaque);
+	if (!passed) {
+		surface->release();
+		return;
+	}
+
+	/* The GPU worker runs once. Release/acquire publishes completed pixels. */
+	sweet_mali_pending_color = color;
+	__atomic_store_n(&sweet_mali_pending_surface, surface, __ATOMIC_RELEASE);
+	IOLog("SWEET MALI: IOSurface ready for next app lock\n");
+}
+
+static void
+sweet_mali_surface_readback(task_t task)
+{
+	if (__atomic_load_n(&sweet_mali_pending_surface, __ATOMIC_ACQUIRE) == NULL ||
+	    task != current_task()) {
+		return;
+	}
+	SweetSurface *surface = __atomic_exchange_n(&sweet_mali_pending_surface,
+	    static_cast<SweetSurface *>(NULL), __ATOMIC_ACQ_REL);
+	if (surface == NULL) {
+		return;
+	}
+
+	IOMemoryMap *mapping = surface->memory->createMappingInTask(task, 0,
+	    kIOMapAnywhere | kIOMapReadOnly | surface->mapCache);
+	bool mapped = mapping != NULL;
+	unsigned matched = 0;
+	int error = 0;
+	if (mapped) {
+		uint32_t row[kSweetMaliTestWidth];
+		for (unsigned y = 0; y < kSweetMaliTestWidth; y++) {
+			error = copyin((user_addr_t)mapping->getAddress() + y * sizeof(row),
+			    row, sizeof(row));
+			if (error != 0) {
+				break;
+			}
+			for (unsigned x = 0; x < kSweetMaliTestWidth; x++) {
+				if (row[x] == (sweet_mali_pending_color | (y * kSweetMaliTestWidth + x))) {
+					matched++;
+				}
+			}
+		}
+		mapping->release();
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	unsigned total = kSweetMaliTestWidth * kSweetMaliTestWidth;
+	IOLog("SWEET MALI: IOSurface app mapping %s %u/%u pixels proc=%s map=%u error=%d\n",
+	    matched == total ? "PASS" : "FAIL", matched, total, name, mapped, error);
+	surface->release();
 }
 
