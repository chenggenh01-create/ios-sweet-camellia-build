 	printf("SWEET MALI: MFG_MISC_CON=%08x dfd=%d done=%d\n", misc, dfd,
@@ -1970,7 +1997,7 @@
 	 * PWR_ISO only isolates signals, it does not hold the clock. */
 	printf("SWEET MALI: gpu clocks on\n");
 	if (mfg1_sram) {
-		mali_bg3d_gate("v39");
+		mali_bg3d_gate("v40");
 	} else {
 		printf("SWEET MALI: bg3d skipped (mfg1 sram not ready)\n");
 	}
