+
+/*
+ * One frame per run, on its own kernel thread. Whatever the timer queues while
+ * this copy runs re-enters the thread call (ONCE: queued, never concurrent), so
+ * no frame is lost and no extra frame is rendered back to back.
+ */
+void
+AppleCLCD::presentCall(thread_call_param_t param0, thread_call_param_t param1)
+{
+	AppleCLCD *fb = (AppleCLCD *)param0;
+	uint64_t start, elapsed;
+	static unsigned int slow_logged;
+	static int trace = -1;
+
+	(void)param1;
+	if (trace < 0) {
+		int value = 0;
+		PE_parse_boot_argn("sweetfbtrace", &value, sizeof(value));
+		trace = value;
+	}
+	IOLockLock(fb->fLock);
+	if (!fb->fPresentQueued) {
+		IOLockUnlock(fb->fLock);
+		return;
+	}
+	fb->fPresentQueued = false;
+	memcpy(fb->fPresentRec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+	fb->fDirty = false;
+	IOLockUnlock(fb->fLock);
+	start = mach_absolute_time();
+	fb->present(fb->fPresentRec);
+	if (trace) {
+		elapsed = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - start, &elapsed);
+		if (elapsed >= 20000000ULL && slow_logged < 32) {
+			slow_logged++;
+			IOLog("SWEET FB: present took %llu us (sweetfbtrace)\n",
+			    elapsed / 1000ULL);
+		}
+	}
 }
 
