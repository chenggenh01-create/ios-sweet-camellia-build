 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	/*
+	 * Panel copies run from a thread call, not from the vsync timer: the
+	 * timer callback only records that a frame is due, so the work loop never
+	 * sits inside a full-panel memcpy.
+	 * KERNEL priority (not the default HIGH) because a frame copy is far more
+	 * work than the "very small amounts" the HIGH group is meant for, and ONCE
+	 * because the KERNEL group runs calls in parallel: a re-entry while the
+	 * copy runs must be queued, not started concurrently on the same buffer.
+	 */
+	fPresentCall = thread_call_allocate_with_options(
+	    (thread_call_func_t)&AppleCLCD::presentCall, this,
+	    THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
