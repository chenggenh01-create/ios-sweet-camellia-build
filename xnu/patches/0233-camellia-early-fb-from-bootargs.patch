diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,4 +1,4 @@
-/*
+﻿/*
  * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
@@ -12,10 +12,10 @@
 #include <kern/misc_protos.h>
 
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static unsigned int early_stride = 4320u / 4;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -28,11 +28,22 @@
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
 
+/* The loader hands us the real scanned-out framebuffer in boot_args.Video;
+ * the compile-time address above is only the QEMU/sweet fallback. */
+void
+sweet_early_config(uintptr_t base, uint32_t row_bytes)
+{
+	if (base != 0 && row_bytes >= EARLY_WIDTH * 4) {
+		early_fb = (volatile uint32_t *)base;
+		early_stride = row_bytes / 4;
+	}
+}
+
 static void
 sweet_early_clear_row(void)
 {
 	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
-		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * early_stride;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
 			line[x] = 0xff000000u;
 		}
@@ -65,7 +76,7 @@
 	for (unsigned int gy = 0; gy < 16; gy++) {
 		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
 			volatile uint32_t *line = EARLY_FB +
-			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * early_stride +
 			    early_col * EARLY_CELL_W;
 			for (unsigned int gx = 0; gx < 8; gx++) {
 				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
@@ -95,7 +106,7 @@
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
-			EARLY_FB[y * EARLY_STRIDE + x] = color;
+			EARLY_FB[y * early_stride + x] = color;
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -8,6 +8,8 @@
 
 #if defined(SWEET)
 void sweet_early_mark(unsigned int stage, const char *label);
+/* Point the early framebuffer console at the loader's real scanout buffer. */
+void sweet_early_config(uintptr_t base, uint32_t row_bytes);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -347,6 +347,10 @@
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	/* Use the framebuffer the loader actually scans out before any mark. */
+	sweet_early_config((uintptr_t)args->Video.v_baseAddr,
+	    (uint32_t)args->Video.v_rowBytes);
+
 	sweet_early_mark(1, "arm_init entered (MMU on)");
 
 	arm_setup_pre_sign();
