+	mali_as0_update(0, 2);
+	printf("SWEET MALI: first job state=%d mapped=%d pt_pages=%u top=%08x%08x\n",
+	    (int)mali_job_state, mapped ? 1 : 0, mali_pt_pages,
+	    (uint32_t)(mali_pt_top_phys >> 32), (uint32_t)mali_pt_top_phys);
